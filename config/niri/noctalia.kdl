layout {

    focus-ring {
        active-color   "#101c2c"
        inactive-color "#fbf9fa"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#101c2c"
        inactive-color "#fbf9fa"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#101c2c"
        inactive-color "#253142"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#101c2c80"
    }
}

recent-windows {
    highlight {
        active-color "#101c2c"
        urgent-color "#ba1a1a"
    }
}
