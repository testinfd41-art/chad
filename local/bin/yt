#!/usr/bin/env bash

set -euo pipefail

# Check dependencies
for cmd in yt-dlp ffmpeg; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: '$cmd' is not installed."
        exit 1
    fi
done

read -rp "Enter YouTube URL: " URL

if [[ -z "$URL" ]]; then
    echo "No URL provided."
    exit 1
fi

echo
echo "Downloading at the highest available quality..."
echo

yt-dlp \
    -f "bv*+ba/b" \
    --merge-output-format mp4 \
    --embed-metadata \
    --embed-thumbnail \
    -o "%(title)s.%(ext)s" \
    "$URL"

echo
echo "Download complete!"

